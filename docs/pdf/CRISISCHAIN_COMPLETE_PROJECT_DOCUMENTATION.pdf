BT /F3 8 Tf 53 778.89 Td (START TRANSACTION;) Tj ET
BT /F3 8 Tf 53 768.39 Td () Tj ET
BT /F3 8 Tf 53 757.89 Td (-- 1. Mark incident resolved) Tj ET
BT /F3 8 Tf 53 747.39 Td (UPDATE incident) Tj ET
BT /F3 8 Tf 53 736.89 Td (SET incident_status = 'Resolved', resolved_at = NOW\(\)) Tj ET
BT /F3 8 Tf 53 726.39 Td (WHERE incident_id = ?;) Tj ET
BT /F3 8 Tf 53 715.89 Td () Tj ET
BT /F3 8 Tf 53 705.39 Td (-- 2. Complete all active assignments) Tj ET
BT /F3 8 Tf 53 694.89 Td (UPDATE incident_assignment) Tj ET
BT /F3 8 Tf 53 684.39 Td (SET assignment_status = 'Completed', completed_at = COALESCE\(completed_at, NOW\(\)\)) Tj ET
BT /F3 8 Tf 53 673.89 Td (WHERE incident_id = ? AND assignment_status IN \('Pending','Accepted','EnRoute','Arrived'\);) Tj ET
BT /F3 8 Tf 53 663.39 Td () Tj ET
BT /F3 8 Tf 53 652.89 Td (-- 3. Free up responders with no remaining active assignments) Tj ET
BT /F3 8 Tf 53 642.39 Td (UPDATE authority_profile ap) Tj ET
BT /F3 8 Tf 53 631.89 Td (SET availability_status = 'Available') Tj ET
BT /F3 8 Tf 53 621.39 Td (WHERE authority_id IN \() Tj ET
BT /F3 8 Tf 53 610.89 Td (    SELECT authority_id FROM incident_assignment WHERE incident_id = ?) Tj ET
BT /F3 8 Tf 53 600.39 Td (\) AND \() Tj ET
BT /F3 8 Tf 53 589.89 Td (    SELECT COUNT\(*\) FROM incident_assignment ia) Tj ET
BT /F3 8 Tf 53 579.39 Td (    WHERE ia.authority_id = ap.authority_id) Tj ET
BT /F3 8 Tf 53 568.89 Td (      AND ia.assignment_status IN \('Pending','Accepted','EnRoute','Arrived'\)) Tj ET
BT /F3 8 Tf 53 558.39 Td (\) = 0;) Tj ET
BT /F3 8 Tf 53 547.89 Td () Tj ET
BT /F3 8 Tf 53 537.39 Td (-- 4. Restore allocated supplies back to resource inventory) Tj ET
BT /F3 8 Tf 53 526.89 Td (UPDATE resource r) Tj ET
BT /F3 8 Tf 53 516.39 Td (JOIN incident_resource_allocation ira ON r.resource_id = ira.resource_id) Tj ET
BT /F3 8 Tf 53 505.89 Td (SET r.quantity_available = r.quantity_available + ira.quantity_allocated) Tj ET
BT /F3 8 Tf 53 495.39 Td (WHERE ira.incident_id = ? AND ira.released_at IS NULL;) Tj ET
BT /F3 8 Tf 53 484.89 Td () Tj ET
BT /F3 8 Tf 53 474.39 Td (-- 5. Mark allocations released) Tj ET
BT /F3 8 Tf 53 463.89 Td (UPDATE incident_resource_allocation) Tj ET
BT /F3 8 Tf 53 453.39 Td (SET released_at = NOW\(\)) Tj ET
BT /F3 8 Tf 53 442.89 Td (WHERE incident_id = ? AND released_at IS NULL;) Tj ET
BT /F3 8 Tf 53 432.39 Td () Tj ET
BT /F3 8 Tf 53 421.89 Td (COMMIT;) Tj ET
